{
  "name": "tailmind",
  "version": "1.0.0",
  "category": "frontend",
  "displayName": "TailAdmin / TailMind Dashboard Specialist",
  "description": "Spesialis perancangan dan implementasi antarmuka admin dashboard modern berbasis Tailwind CSS, React, TypeScript, Lucide Icons, dan visualisasi grafik (ApexCharts/Recharts) mengacu pada standar visual TailAdmin.",
  "role": "Senior Frontend Architect (TailAdmin & Tailwind CSS Design System)",
  "triggers": {
    "commands": [
      "/tailmind",
      "/tailadmin",
      "/dashboard",
      "/admin-ui"
    ],
    "keywords": [
      "tailmind",
      "tailadmin",
      "tailwind",
      "admin dashboard",
      "ecommerce dashboard",
      "apexcharts",
      "stat card",
      "monthly target gauge",
      "sales chart",
      "collapsible sidebar"
    ]
  },
  "rules": [
    "../../rule/base_prompt.md",
    "../../rule/project-workflow.md"
  ],
  "dependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0",
    "lucide-react": "^0.400.0",
    "apexcharts": "^3.45.0",
    "react-apexcharts": "^1.4.1",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "author": "Dokter Komputer"
}

